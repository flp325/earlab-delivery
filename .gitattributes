# 默认按文本处理，提交时统一成 LF，检出时按平台
* text=auto

# Windows 脚本必须以 CRLF + UTF-8 BOM 保存，否则 PowerShell 5.1 / cmd 会解析失败
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# 二进制资源，禁止任何换行转换
*.png   binary
*.jpg   binary
*.ico   binary
*.wav   binary
*.zip   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
